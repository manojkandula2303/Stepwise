{
  "name": "stepwise",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:server": "node --experimental-sqlite --no-warnings=ExperimentalWarning server/index.mjs",
    "build": "tsc -b && vite build",
    "start": "node --experimental-sqlite --no-warnings=ExperimentalWarning scripts/start.mjs",
    "typecheck": "tsc -b",
    "test:api": "node scripts/test-api.mjs",
    "db:migrate": "node --experimental-sqlite --no-warnings=ExperimentalWarning scripts/migrate-to-postgres.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.18.1",
    "@codemirror/commands": "6.7.1",
    "@codemirror/lang-cpp": "6.0.2",
    "@codemirror/lang-java": "6.0.1",
    "@codemirror/lang-python": "6.1.6",
    "@codemirror/language": "6.10.3",
    "@codemirror/search": "6.5.6",
    "@codemirror/state": "6.4.1",
    "@codemirror/view": "6.34.1",
    "@lezer/cpp": "1.1.6",
    "@lezer/highlight": "1.2.1",
    "@lezer/java": "1.2.0",
    "@lezer/python": "1.1.19",
    "express": "^4.22.3",
    "lucide-react": "0.453.0",
    "marked": "14.1.3",
    "pg": "^8.23.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "^7.18.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.1",
    "@electric-sql/pglite-socket": "^0.3.1",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "typescript": "5.6.3",
    "vite": "^8.4.0"
  },
  "engines": {
    "node": ">=22.5"
  }
}
