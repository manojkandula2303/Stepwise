{
  "name": "stepwise",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:server": "node --experimental-sqlite --no-warnings=ExperimentalWarning server/index.mjs",
